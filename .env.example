# Copy to .env and fill in for `docker compose up` — see README "Deployment".

# Shared passcode gating the whole app (single-user, not real multi-user
# auth) behind an HTTP-only session cookie. Leave unset/empty to keep
# existing deploys with zero login friction - auth is skipped entirely.
# APP_PASSCODE=

# Host port the web app is served on.
WEB_PORT=8080

# Only used with docker-compose.ghcr.yml (published images): which image
# tag to pull. "latest" tracks main; pin a version instead, e.g. "1.2.0".
IMAGE_TAG=latest

# Discord webhook URL to post idle-training reminders to. Leave unset to
# disable notifications entirely (the cron job runs but no-ops).
DISCORD_WEBHOOK_URL=

# Public URL this app is reachable at, used to build the "quick log" deep
# links in Discord reminders. Should match how you actually access the app.
PUBLIC_APP_URL=http://localhost:8080

# Cron schedule (5-field crontab syntax) that runs the idle-training check.
# Default: hourly on the hour, 8am-10pm — interpreted in NOTIFY_TIMEZONE
# below, not necessarily the host's timezone. The check itself is what
# decides whether NOTIFY_IDLE_HOURS has actually passed, so this just
# controls how soon after that a reminder can go out - and only once per
# idle stretch per day (a fresh calendar day allows one more even without
# a new set logged, so a string of inactive days still gets a daily nudge
# instead of going silent after the first one).
NOTIFY_CRON_SCHEDULE=0 8-22 * * *

# Timezone the schedule above is interpreted in (IANA name, e.g.
# Europe/Paris). Docker containers default to UTC regardless of the host
# machine's timezone, so set this explicitly or the "8am-10pm" window won't
# mean what you expect.
NOTIFY_TIMEZONE=UTC

# Hours of no logged sets before a reminder is sent.
NOTIFY_IDLE_HOURS=1

# Cron schedule for the nightly automatic backup (written to disk next to
# the sqlite file, downloadable from the System page). Keeps every backup
# from the last 7 days plus one per month for the 3 months before that.
# Interpreted in NOTIFY_TIMEZONE above. Default: 3am.
BACKUP_CRON_SCHEDULE=0 3 * * *

#APP_PASSCODE=abcdef